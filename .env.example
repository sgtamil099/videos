# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Multi-AI Director Providers (server-side only):
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL / PostgreSQL Connection Variables (Object Method)
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="vyro_studio"
SQL_USER="app_user"
SQL_PASSWORD="change_me"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="change_me"

# Optional: URL to the Python FastAPI NVIDIA CUDA GPU Worker (e.g. http://localhost:8000)
GPU_WORKER_URL=""
